# ¿quién me tocó? — variables de entorno
# todo sale de planes gratis. copiá este archivo a .env.local y pegá lo mismo en vercel.

# --- app ---
# url pública (sin barra final). en vercel: https://tu-proyecto.vercel.app o tu subdominio de ear.dev
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- starknet sepolia (testnet, gratis) ---
# rpc público gratis. alternativas: alchemy / infura / nethermind en su plan gratis.
NEXT_PUBLIC_STARKNET_RPC_URL=https://api.zan.top/public/starknet-sepolia/rpc/v0_10
# dirección del contrato (la imprime scripts/deploy-sepolia.sh)
NEXT_PUBLIC_CONTRACT_ADDRESS=
# bloque del despliegue (opcional, acota la búsqueda de eventos en "verificá")
NEXT_PUBLIC_CONTRACT_DEPLOY_BLOCK=

# --- cavos (login google/apple + wallets + paymaster; gratis hasta 1,000 wallets) ---
# dashboard: https://cavos.xyz/dashboard → app → app id y paymaster api key (sepolia es gratis e ilimitado)
NEXT_PUBLIC_CAVOS_APP_ID=
# development | production. en local usamos el environment id de development.
NEXT_PUBLIC_CAVOS_ENVIRONMENT=development
NEXT_PUBLIC_CAVOS_PAYMASTER_API_KEY=

# --- cuenta del servidor en sepolia (operator del contrato; paga su gas con strk del faucet) ---
# las imprime: pnpm tsx scripts/print-server-env.ts qmt-server
SERVER_STARKNET_ADDRESS=
SERVER_STARKNET_PRIVATE_KEY=

# --- llave x25519 del servidor (cifra los papelitos de los sin cuenta y el paquete de revelación) ---
# las imprime el mismo script. si ya hay grupos sorteados en producción, NO la cambiés.
SERVER_ENC_PRIVATE_KEY=
NEXT_PUBLIC_SERVER_ENC_PUBKEY=

# --- upstash redis (kv mínimo; plan gratis: 500k comandos/mes) ---
# sin estas dos la app usa una memoria en proceso (sirve para desarrollo local)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- resend (correos; plan gratis: 3,000/mes, 100/día) ---
RESEND_API_KEY=
# remitente: con dominio verificado en resend, o el de pruebas
RESEND_FROM="quien me toco <onboarding@resend.dev>"
