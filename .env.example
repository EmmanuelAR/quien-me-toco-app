# ¿quién me tocó? — variables de entorno
# copiá este archivo a .env.local y pegá lo mismo en vercel.

# --- app ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- neon postgres ---
# neon console → project → connection string (pooled ok)
DATABASE_URL=

# --- neon managed better auth (google) ---
# neon neon-auth status --project-id <id> --branch production
NEON_AUTH_BASE_URL=
# openssl rand -base64 32  (≥32 caracteres)
NEON_AUTH_COOKIE_SECRET=

# --- resend (correos al sortear; opcional pero recomendado) ---
# https://resend.com/api-keys — sin esto no se manda nada
RESEND_API_KEY=
# en free, usá onboarding@resend.dev; con dominio verificado: "¿Quién me tocó? <hola@tudominio.com>"
RESEND_FROM="¿Quién me tocó? <onboarding@resend.dev>"

# --- cron purge (obligatorio en prod si usás el cron) ---
CRON_SECRET=

# --- herramientas de prueba (solo local/preview; nunca en Vercel production) ---
# ENABLE_TEST_TOOLS=1
